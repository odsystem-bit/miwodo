# Firebase (lib/services/firebase_service.dart)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Moneroo — UNIQUEMENT côté serveur (API PHP), jamais dans l'app Flutter
# Configurer dans server/api/.env
MONEROO_SECRET_KEY=

# API de paiement (hébergement mutualisé PHP/MySQL)
PAYMENT_API_URL=https://miwodo.tg/api
PAYMENT_API_KEY=

# App
APP_URL=https://miwodo.tg
PARRAIN_BASE_URL=https://miwodo.tg/ref/

# File size on device
adb shell du -sh /storage/emulated/0/* | sort -h | tail -n 10

# File size on device
git clone miwodo.bundle miwodo-clone
cd miwodo-clone
git remote add origin https://github.com/odsystem-bit/miwodo.git
git push -u origin --all
git push -u origin --tags
