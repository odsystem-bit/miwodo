# ═══════════════════════════════════════════════════════════════════════════
# MIWODO API — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════════════════

# Clé API Moneroo (https://moneroo.io)
MONEROO_SECRET_KEY=sk_votre_cle_secrete

# Clé API pour authentifier l'app Flutter (choisir une chaîne aléatoire longue)
PAYMENT_API_KEY=miwodo_api_key_aleatoire_a_generer

# Base de données MySQL
DB_HOST=localhost
DB_NAME=miwodo_payments
DB_USER=votre_utilisateur_mysql
DB_PASS=votre_mot_de_passe_mysql
