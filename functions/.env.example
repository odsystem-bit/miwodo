# Configuration Moneroo
# Obtenez votre clé API sur https://moneroo.io
MONEROO_SECRET_KEY=votre_cle_secrete_ici

# Configuration Admin - Secret obligatoire pour créer le premier super_admin
# Changez cette valeur en production ! Minimum 32 caractères recommandé.
ADMIN_SETUP_SECRET=changez_moi_par_un_secret_tres_long_et_aleatoire

# Configuration Firebase (déjà configurée par Firebase CLI)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
